<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/dashboard-view.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.tecnobinary.allstarssports.controller.DashboardController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="lblBienvenida" styleClass="titulo" text="Bienvenido" />
            <Label fx:id="lblRol" styleClass="subtitulo" text="Rol" />
            <Button fx:id="btnGestionarLigas" mnemonicParsing="false" onAction="#handleGestionarLigas" text="Gestionar Ligas" />
            <Button fx:id="btnGestionarMiembros" mnemonicParsing="false" onAction="#handleGestionarMiembros" text="Gestionar Miembros" />
            <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#handleCerrarSesion" text="Cerrar Sesión" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <TableView fx:id="tableEquipos" prefHeight="400.0">
               <columns>
                  <TableColumn fx:id="colIdEquipo" prefWidth="100.0" text="ID" />
                  <TableColumn fx:id="colNombreEquipo" prefWidth="300.0" text="Equipo" />
                  <TableColumn fx:id="colNombreLiga" prefWidth="300.0" text="Liga" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
