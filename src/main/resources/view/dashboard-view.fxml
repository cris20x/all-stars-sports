<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="960.0"
            minHeight="480.0" minWidth="720.0"
            stylesheets="@../css/dashboard-view.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.com.tecnobinary.allstarssports.controller.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>

            <children>
                <Label fx:id="lblBienvenida"
                       styleClass="titulo"
                       text="Bienvenido"
                       HBox.hgrow="ALWAYS" />

                <Label fx:id="lblRol"
                       styleClass="subtitulo"
                       text="Rol" />

                <Button fx:id="btnGestionarLigas"
                        mnemonicParsing="false"
                        onAction="#handleGestionarLigas"
                        styleClass="boton-admin"
                        text="⚙ Gestionar Ligas" />

                <Button fx:id="btnGestionarEquipos"
                        mnemonicParsing="false"
                        onAction="#handleGestionarEquipos"
                        styleClass="boton-admin"
                        text="⚙ Gestionar Equipos" />

                <Button fx:id="btnCerrarSesion"
                        mnemonicParsing="false"
                        onAction="#handleCerrarSesion"
                        styleClass="boton-salir"
                        text="Cerrar Sesión" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-contenido" BorderPane.alignment="CENTER">
        <VBox spacing="14.0">

            <padding>
                <Insets bottom="24.0"
                        left="24.0"
                        right="24.0"
                        top="24.0" />
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">

                    <Label text="Equipos"
                           styleClass="seccion-titulo"
                           HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnVistaLista"
                            mnemonicParsing="false"
                            onAction="#handleVistaLista"
                            styleClass="boton-vista-activo"
                            text="☷ Lista" />

                    <Button fx:id="btnVistaCuadricula"
                            mnemonicParsing="false"
                            onAction="#handleVistaCuadricula"
                            text="▦ Cuadrícula" />

                </HBox>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10.0"
                      styleClass="equipos-actions">

                    <children>

                        <Button fx:id="btnUnirseEquipo"
                                mnemonicParsing="false"
                                onAction="#handleUnirseEquipo"
                                styleClass="boton-participante"
                                text="+ Unirse a un Equipo" />

                        <Button fx:id="btnMisEquipos"
                                mnemonicParsing="false"
                                onAction="#handleMisEquipos"
                                styleClass="boton-participante"
                                text="Mis Equipos" />

                    </children>

                </HBox>

                <TableView fx:id="tableEquipos"
                           prefHeight="400.0"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="colIdEquipo"
                                     prefWidth="70.0"
                                     minWidth="50.0"
                                     text="ID" />

                        <TableColumn fx:id="colNombreEquipo"
                                     prefWidth="260.0"
                                     minWidth="120.0"
                                     text="Equipo" />

                        <TableColumn fx:id="colNombreLiga"
                                     prefWidth="180.0"
                                     minWidth="100.0"
                                     text="Liga" />

                        <TableColumn fx:id="colDeporte"
                                     prefWidth="140.0"
                                     minWidth="90.0"
                                     text="Deporte" />

                        <TableColumn fx:id="colAccionesEquipo"
                                     prefWidth="180.0"
                                     minWidth="140.0"
                                     sortable="false"
                                     text="Acciones" />

                    </columns>

                </TableView>

                <FlowPane fx:id="gridEquipos"
                          hgap="16.0"
                          vgap="16.0"
                          alignment="TOP_LEFT"
                          visible="false"
                          managed="false"
                          VBox.vgrow="ALWAYS" />

            </children>
        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
