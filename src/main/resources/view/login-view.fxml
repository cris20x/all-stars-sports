<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" stylesheets="@../css/login-view.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.tecnobinary.allstarssports.controller.LoginController">
   <padding>
      <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="All-Stars Sports League" />
      <Label text="Correo electrónico" />
      <TextField fx:id="txtFieldEmail" promptText="correo@ejemplo.com" />
      <Label text="Contraseña" />
      <PasswordField fx:id="txtFieldPassword" promptText="Contraseña" />
      <Button fx:id="btnIniciarSesion" mnemonicParsing="false" onAction="#handleLogin" text="Iniciar Sesión" />
   </children>
</VBox>
