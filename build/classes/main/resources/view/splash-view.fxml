<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="18.0" styleClass="splash-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.tecnobinary.allstarssports.controller.SplashController">

    <children>

        <Pane fx:id="confettiPane" mouseTransparent="true" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: black;">

            <children>

                <ImageView fx:id="imgLogo" fitHeight="190.0" fitWidth="190.0" layoutX="205.0" layoutY="80.0" preserveRatio="true" smooth="true" />

                <Label fx:id="lblAutor" alignment="CENTER" layoutX="0.0" layoutY="290.0" prefWidth="600.0" styleClass="autor" text="Hecho por: TecnoBinaryJC" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Italic" size="14.0" />
               </font></Label>

            </children>

        </Pane>

    </children>

</VBox>
